[
    // ---------------------------------------------------------------------
    // SubMerge - default key bindings (Linux)
    // macOS bindings live in "Default (OSX).sublime-keymap".
    //
    // Every binding that is active by default is gated on a SubMerge
    // context, so none of them claim a key outside a SubMerge comparison or
    // folder result.  There are not enough key combinations to go round, and
    // a package that takes one globally takes it from every other package.
    //
    // The commands that *start* a comparison cannot be gated - there is no
    // comparison yet to test for - so they ship commented out rather than
    // claiming five global combinations on everyone's behalf.  Uncomment any
    // you want, or bind your own.
    //
    // Nothing here is required: every command is on the Command Palette.
    // Press Ctrl+Shift+P and type "submerge".
    // ---------------------------------------------------------------------

    // --- Starting a comparison --------------------------------------------
    // Off by default.  Uncomment to enable, or copy into your own keymap
    // (Tools > SubMerge > Key Bindings).

    // Start a comparison by picking 2-3 open tabs.
    // { "keys": ["ctrl+alt+d"], "command": "submerge_compare_open_tabs" },

    // Compare the 2-3 tabs selected in the tab bar.
    // { "keys": ["ctrl+alt+shift+d"], "command": "submerge_compare_selected_tabs" },

    // Mark the current tab for a later comparison.
    // { "keys": ["ctrl+alt+m"], "command": "submerge_mark_for_compare" },

    // Compare the current tab against a file chosen on disk.
    // { "keys": ["ctrl+alt+o"], "command": "submerge_compare_with_file" },

    // File metadata comparison for the active comparison / marked tabs.
    // { "keys": ["ctrl+alt+i"], "command": "submerge_metadata_report" },

    // --- Active by default, and gated --------------------------------------

    // Only claims the key while something is actually marked.
    {
        "keys": ["ctrl+alt+shift+m"], "command": "submerge_compare_with_marked",
        "context": [{ "key": "submerge_has_marked", "operand": true }]
    },

    // Navigation inside an active comparison.
    {
        "keys": ["f7"], "command": "submerge_next_difference",
        "context": [{ "key": "submerge_active", "operand": true }]
    },
    {
        "keys": ["shift+f7"], "command": "submerge_previous_difference",
        "context": [{ "key": "submerge_active", "operand": true }]
    },
    {
        "keys": ["ctrl+alt+home"], "command": "submerge_first_difference",
        "context": [{ "key": "submerge_active", "operand": true }]
    },
    {
        "keys": ["ctrl+alt+end"], "command": "submerge_last_difference",
        "context": [{ "key": "submerge_active", "operand": true }]
    },

    {
        "keys": ["ctrl+alt+j"], "command": "submerge_goto_moved_partner",
        "context": [{ "key": "submerge_active", "operand": true }]
    },

    // Merging.
    {
        "keys": ["ctrl+alt+right"], "command": "submerge_copy_difference",
        "args": { "to": "right" },
        "context": [{ "key": "submerge_active", "operand": true }]
    },
    {
        "keys": ["ctrl+alt+left"], "command": "submerge_copy_difference",
        "args": { "to": "left" },
        "context": [{ "key": "submerge_active", "operand": true }]
    },
    {
        "keys": ["ctrl+alt+shift+right"], "command": "submerge_copy_all_differences",
        "args": { "to": "right" },
        "context": [{ "key": "submerge_active", "operand": true }]
    },
    {
        "keys": ["ctrl+alt+shift+left"], "command": "submerge_copy_all_differences",
        "args": { "to": "left" },
        "context": [{ "key": "submerge_active", "operand": true }]
    },

    // Session control.  Two bindings for refresh because a context list is
    // ANDed together, and this key serves a comparison or a folder result.
    {
        "keys": ["ctrl+alt+r"], "command": "submerge_refresh",
        "context": [{ "key": "submerge_active", "operand": true }]
    },
    {
        "keys": ["ctrl+alt+r"], "command": "submerge_refresh",
        "context": [{ "key": "submerge_folder_view", "operand": true }]
    },
    {
        "keys": ["ctrl+alt+shift+w"], "command": "submerge_end_comparison",
        "context": [{ "key": "submerge_active", "operand": true }]
    },

    // Folder comparison results.
    {
        "keys": ["enter"], "command": "submerge_folder_open_row",
        "context": [
            { "key": "submerge_folder_view", "operand": true },
            { "key": "auto_complete_visible", "operand": false },
            { "key": "panel_has_focus", "operand": false }
        ]
    },
    {
        "keys": ["f5"], "command": "submerge_folder_rescan",
        "args": { "group": -1, "index": -1 },
        "context": [{ "key": "submerge_folder_view", "operand": true }]
    }
]
