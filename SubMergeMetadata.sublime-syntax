%YAML 1.2
---
# SubMerge metadata comparison report.
name: SubMerge Metadata Comparison
scope: text.submerge.metadata
hidden: true
file_extensions: []

contexts:
  main:
    - match: ^SubMerge.*$
      scope: markup.heading.submerge
    - match: ^\s{2}[ABC]:\s.*$
      scope: comment.line.root.submerge
    - match: ^\s{2}(?:Content|Metadata):\s*IDENTICAL.*$
      scope: markup.folder.identical.submerge
    - match: ^\s{2}(?:Content):\s*DIFFERENT.*$
      scope: markup.folder.different.submerge
    - match: ^\s{2}(?:Metadata):\s*DIFFERENT.*$
      scope: markup.folder.metadata.submerge
    - match: ^\s{2}!\s.*$
      scope: markup.folder.different.submerge
    - match: ^\s{2}=\s.*$
      scope: markup.folder.identical.submerge
    - match: ^\s{2}~\s.*$
      scope: markup.folder.metadata.submerge
    - match: ^\s{4}-+$
      scope: comment.line.rule.submerge
    - match: ^\s{2}'!'.*$|^\s{2}Name, path.*$|^\s{2}count as.*$
      scope: comment.line.note.submerge
