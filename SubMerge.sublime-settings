{
    // ---------------------------------------------------------------------
    // SubMerge - default settings
    //
    // Do not edit this file directly.  Use
    //     Tools > SubMerge > Settings
    // (or Preferences > Package Settings > SubMerge > Settings) which opens
    // your own override file side by side with this one.
    //
    // NOTE: "colors" is a single setting.  If you override it, copy the whole
    // block and change the entries you care about.
    // ---------------------------------------------------------------------

    // -- appearance ---------------------------------------------------------
    // Line and inline diff highlighting uses six of Sublime's built-in
    // "region.*ish" scopes (added = greenish, modified = yellowish, the
    // changed part of a line = orangish/redish, moved = bluish, current
    // difference = purplish). Every color scheme, including Sublime's own
    // built-in ones, already defines real colors for these - that is what
    // makes them show up with zero configuration, in any color scheme,
    // without SubMerge needing to generate or merge anything for them.
    //
    // The trade-off: those eight scopes are shared with other plugins and
    // with Sublime itself (bookmarks, git status, linters, ...), so SubMerge
    // does not override their colors here - doing so would recolor those
    // other features too. There is therefore no "colors" key for added_line,
    // changed_line, changed_inline, moved_line or current_hunk - what you see
    // is your own color scheme's idea of "greenish"/"yellowish"/etc. If you
    // want a different look, the color scheme you use is what controls it.
    //
    // "color_preset" and "colors" below still apply to the two things that
    // ARE fully custom to SubMerge and safe to recolor: the folder-comparison
    // / metadata-report tabs, and the fill color of the artificial gaps.
    //   "vivid" (default) / "classic" / "high_contrast" / "pastel" /
    //   "colorblind_safe"
    "color_preset": "vivid",

    // How a difference is drawn:
    //   "background" - filled highlight (the classic look). The only style
    //                   guaranteed to also show up in the minimap.
    //   "underline"   - a solid colored underline; the text underneath keeps
    //                   its own syntax color, a lighter touch than a fill.
    //   "squiggly"    - the same, but a wavy underline (spell-check style).
    // There is no "recolor the text itself" option: add_regions() can fill,
    // outline or underline a region, but has no way to recolor the rendered
    // text within it - only real syntax highlighting can do that, which
    // doesn't apply to dynamically-computed diff regions. See the README.
    "highlight_style": "background",

    // Give a line whose content is substantially different (as opposed to a
    // one-word tweak) the more intense "redish" color instead of the normal
    // "orangish" one, so a small edit and a rewritten line no longer look
    // the same at a glance.
    "graduated_inline_highlight": true,

    // The fraction of a line's characters that must differ (0.0-1.0) before
    // it counts as "substantially different" and gets the major color.
    "inline_intensity_threshold": 0.4,

    // -- colors ----------------------------------------------------------
    // Applies only to the folder-comparison / metadata-report tabs and the
    // gap fill - see "appearance" above for why line/inline diff colors
    // aren't listed here. Every entry may be either a color string
    // ("#RRGGBB", "#RRGGBBAA" or "rgba(r,g,b,a)"), or an object of the form
    // { "background": "#...", "foreground": "#..." } for the folder/metadata
    // entries if you also want to force the text color.
    //
    // Leave this empty (the default) to use "color_preset" untouched, or set
    // only the keys you want to change - anything you don't set here still
    // comes from the preset. Changing any of this rewrites
    // Packages/User/SubMerge.hidden-color-scheme.
    "colors": {},

    // Reference: every key a preset defines, with the "vivid" preset's own
    // values shown as an example. Copy any of these into "colors" above to
    // override just that one thing.
    //
    // "gap":               "rgba(229,57,53,0.12)" - fill of the artificial
    //                       gaps that stand in for missing lines
    // "folder_identical":  "#7E8B8B"
    // "folder_metadata":   "#8A7BC8"
    // "folder_different":  "#E69800"
    // "folder_unique":     "#E5533D"
    // "folder_directory":  "#4A90D9"

    // How much of a differing line to paint:
    //   "auto"   - if only part of the line differs, highlight just that part;
    //              lines with no counterpart are painted in full
    //   "always" - always paint the whole line as well as the changed part
    //   "never"  - only ever paint the changed characters
    "highlight_changed_line": "auto",

    // -- what counts as a difference --------------------------------------
    "ignore_whitespace": false,        // ignore leading/trailing + runs of spaces
    "ignore_all_whitespace": false,    // ignore whitespace entirely
    "ignore_case": false,
    "ignore_blank_lines": false,

    // Treat CRLF (Windows), LF (Unix) and CR (classic Mac) as equal.  This
    // also applies to folder comparison hashing and stops end-of-line style
    // from being reported as a metadata difference.
    //
    // Left ON by default: with it off, comparing a Windows file against a
    // Mac/Linux copy of the same text marks EVERY line as different, which
    // is confusing if you don't already know why.  Turn it off when the
    // end-of-line style itself is what you're checking.
    "ignore_line_endings": true,

    // Granularity of the in-line highlight: "word", "char" or "none".
    "intraline_mode": "word",

    // -- moved line detection ---------------------------------------------
    // A line that only exists in pane A and an identical line that only
    // exists in pane B are reported as *moved* rather than as a deletion
    // plus an insertion, and painted with the "region.bluish" scope.
    "detect_moved_lines": true,

    // Lines shorter than this (after trimming) are never treated as moved -
    // otherwise every "}" in the file matches every other one.
    "moved_min_length": 3,

    // -- display ----------------------------------------------------------
    // Render artificial gaps where lines are missing so both tabs stay
    // aligned.
    "show_gaps": true,

    // Gutter icon drawn next to changed lines: "", "dot", "circle" or
    // "bookmark".
    "gutter_icon": "dot",

    // Difference highlights are drawn in the minimap automatically.  Set
    // this to true to suppress them (this also hides them in the text area).
    "hide_diff_in_minimap": false,

    // Word wrap breaks line-for-line alignment, so it is disabled in
    // compared tabs and restored afterwards.
    "disable_word_wrap": true,

    // Allows the last differences of a shorter file to line up.
    "scroll_past_end": true,

    // -- windows and layout -----------------------------------------------
    // Open the compared files in a brand new Sublime Text window instead of
    // splitting the current one.
    "compare_in_new_window": true,

    // Chrome for windows SubMerge opens itself.  These never touch a window
    // you opened yourself - only ones the plugin creates.
    //
    // Hide the side bar in every window SubMerge opens.
    "new_window_hide_sidebar": true,

    // Hide the minimap in a new *file comparison* window.  Left on by
    // default because the minimap shows the difference markers.
    "new_window_hide_minimap": false,

    // Hide the minimap in a new *folder comparison* or *metadata report*
    // window.  These are generated text, so the minimap adds nothing.
    "report_window_hide_minimap": true,

    // What to do with the layout when a comparison ends:
    //   "restore" - go back to the layout that was in use beforehand
    //   "single"  - always collapse to a single pane
    //   "keep"    - leave the split alone
    "layout_on_close": "restore",

    // Tear the comparison down automatically when one of the compared tabs
    // is closed.
    "restore_layout_on_close": true,

    // -- behavior --------------------------------------------------------
    "sync_scroll": true,
    "sync_horizontal_scroll": true,
    "sync_selection": true,
    "sync_interval_ms": 60,            // scroll polling interval

    "live_diff": true,                 // re-diff while you type
    "live_diff_delay_ms": 400,

    "wrap_navigation": true,           // next/previous difference wraps around
    "confirm_copy_all": true,

    // -- file metadata ----------------------------------------------------
    // Compare size, timestamps, permissions, line endings, encoding, ... in
    // addition to content.  When the content is identical but the metadata
    // is not, SubMerge offers to open a metadata comparison tab instead of a
    // side-by-side comparison.  Folder comparison then also flags
    // metadata-only differences with [~].
    //
    // Left OFF by default because of the cost during a *folder* comparison:
    // with it on, every matched file is hashed for content AND read fully
    // into memory and hashed twice more for metadata.  That is fine for a
    // few hundred files and noticeably slower on a large tree.  Turn it on
    // when you care about dates/permissions/encoding; it is cheap for
    // one-off file comparisons.
    "compare_metadata": false,

    // Which fields count as a metadata difference.  Available fields:
    //   size, modified, permissions, readonly, lines, line_endings,
    //   final_newline, bom, encoding, sha1
    // (name, path, created and accessed are always reported but never
    // counted).  Set to null to use the default list.
    "metadata_fields": null,

    // Also open the metadata report when the *content* differs.
    "metadata_report_always": false,

    // Where a metadata comparison tab opens.  A side-by-side comparison
    // splits the window into narrow columns, which is an awkward place for a
    // wide table, so by default the report avoids any window that is running
    // a comparison.
    //   "auto"    - the window you asked from, unless that window is showing
    //               a comparison; then a separate single column window
    //               (reused for later reports rather than piling up)
    //   "new"     - always a separate single column window
    //   "current" - wherever you asked from, comparison columns and all
    "metadata_report_window": "auto",

    // -- CSV / TSV table view ---------------------------------------------
    // Render delimited files as an aligned table (read-only) before
    // comparing them.  Merging is not available in this mode.
    "csv_table_view": false,

    // "auto", or an explicit delimiter such as "," ";" "|" "\t".
    "csv_delimiter": "auto",

    // Columns wider than this are wrapped onto extra lines within the cell.
    "csv_max_column_width": 40,
    "csv_min_column_width": 3,
    "csv_wrap_columns": true,
    "csv_row_numbers": true,
    "csv_header_rule": true,

    // Extra extensions to treat as delimited files (.csv, .tsv, .tab and
    // .psv are always recognized).
    "csv_extra_extensions": [],

    // -- folder comparison ------------------------------------------------
    // "content" (hash), "size_and_time" or "size".
    "folder_compare_mode": "content",

    // 0 = unlimited recursion.
    "folder_max_depth": 0,

    // Set to false to exclude identical files (and folders whose contents
    // are all identical) from the results.
    "folder_show_identical": true,

    "folder_exclude_patterns":
    [
        ".git",
        ".svn",
        ".hg",
        "node_modules",
        "__pycache__",
        "*.pyc",
        "*.pyo",
        ".DS_Store",
        "Thumbs.db"
    ]
}
