[
    // ---------------------------------------------------------------------
    // SubMerge - default key bindings (macOS)
    // ---------------------------------------------------------------------

    { "keys": ["super+alt+d"], "command": "submerge_compare_open_tabs" },

    // Compare the 2-3 tabs selected in the tab bar.
    { "keys": ["super+alt+shift+d"], "command": "submerge_compare_selected_tabs" },
    { "keys": ["super+alt+m"], "command": "submerge_mark_for_compare" },
    { "keys": ["super+alt+shift+m"], "command": "submerge_compare_with_marked" },
    { "keys": ["super+alt+o"], "command": "submerge_compare_with_file" },

    {
        "keys": ["f7"], "command": "submerge_next_difference",
        "context": [{ "key": "submerge_active", "operand": true }]
    },
    {
        "keys": ["shift+f7"], "command": "submerge_previous_difference",
        "context": [{ "key": "submerge_active", "operand": true }]
    },
    {
        "keys": ["super+alt+home"], "command": "submerge_first_difference",
        "context": [{ "key": "submerge_active", "operand": true }]
    },
    {
        "keys": ["super+alt+end"], "command": "submerge_last_difference",
        "context": [{ "key": "submerge_active", "operand": true }]
    },

    {
        "keys": ["super+alt+j"], "command": "submerge_goto_moved_partner",
        "context": [{ "key": "submerge_active", "operand": true }]
    },
    { "keys": ["super+alt+i"], "command": "submerge_metadata_report" },

    {
        "keys": ["super+alt+right"], "command": "submerge_copy_difference",
        "args": { "to": "right" },
        "context": [{ "key": "submerge_active", "operand": true }]
    },
    {
        "keys": ["super+alt+left"], "command": "submerge_copy_difference",
        "args": { "to": "left" },
        "context": [{ "key": "submerge_active", "operand": true }]
    },
    {
        "keys": ["super+alt+shift+right"], "command": "submerge_copy_all_differences",
        "args": { "to": "right" },
        "context": [{ "key": "submerge_active", "operand": true }]
    },
    {
        "keys": ["super+alt+shift+left"], "command": "submerge_copy_all_differences",
        "args": { "to": "left" },
        "context": [{ "key": "submerge_active", "operand": true }]
    },

    { "keys": ["super+alt+r"], "command": "submerge_refresh" },
    { "keys": ["super+alt+shift+w"], "command": "submerge_end_comparison" },

    {
        "keys": ["enter"], "command": "submerge_folder_open_row",
        "context": [
            { "key": "submerge_folder_view", "operand": true },
            { "key": "auto_complete_visible", "operand": false },
            { "key": "panel_has_focus", "operand": false }
        ]
    },
    {
        "keys": ["f5"], "command": "submerge_folder_rescan",
        "args": { "group": -1, "index": -1 },
        "context": [{ "key": "submerge_folder_view", "operand": true }]
    }
]
